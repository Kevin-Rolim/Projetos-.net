@model EventoCreateViewModel
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form method="post" >
        <label>Título do evento:</label>
        <input type="text" asp-for="Titulo" placeholder="Insira o Titulo do evento" required maxlength="50"  minlength="3" >
        <span asp-validation-for="Titulo"></span>
        <br>
        <label>Descrição do evento:</label>
        <input type="text" asp-for="Descricao" placeholder="Insira a descricao do evento" maxlength="100">
        <span asp-validation-for="Descricao"></span>
        <br>
        <label>Data do evento:</label>
        <input type="datetime-local" asp-for="DataHora" placeholder="Insira a data do evento"required>
        <span asp-validation-for="DataHora"></span>
        <br>
        <label>Local do evento:</label>
        <input type="text" asp-for="Local" placeholder="Insira o local do evento" required maxlength="100" minlength="3">
        <span asp-validation-for="Local"></span>
        <br>
        <label>Capacidade Máxima:</label>
        <input type="number" asp-for="CapacidadeMaxima" placeholder="Insira a capacidade maxima do evento" required min="1"max="999999">
        <span asp-validation-for="CapacidadeMaxima"></span>
        <br>
        <button type="submit">Enviar</button>
        <button type="reset">Reset</button>
    </form>
</body>
</html>